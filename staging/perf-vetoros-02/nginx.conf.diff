--- nginx/nginx.conf	2026-09-18 17:03:18.032923645 +0000
+++ staging/perf-vetoros-02/nginx/nginx.conf	2026-09-30 18:42:37.743097451 +0000
@@ -6,5 +6,31 @@
     default_type application/octet-stream;
     sendfile on;
     server_tokens off;
+
+    # "combined" + host e tempos (PERF-VETOROS-02)
+    log_format timed '$remote_addr - $remote_user [$time_local] "$request" '
+                     '$status $body_bytes_sent "$http_referer" "$http_user_agent" '
+                     'host=$host rt=$request_time urt=$upstream_response_time '
+                     'rl=$request_length ce=$sent_http_content_encoding pd=$http_x_inertia_partial_data method=$request_method uri=$request_uri';
+    access_log /var/log/nginx/access.log timed;
+
+    # Compressão só de formatos textuais; text/html já é incluído por padrão.
+    # JPEG/PNG/WebP ficam de fora (já comprimidos).
+    gzip on;
+    gzip_comp_level 5;
+    gzip_min_length 1024;
+    gzip_vary on;
+    gzip_proxied any;
+    gzip_types
+        application/json
+        application/javascript
+        text/javascript
+        text/css
+        image/svg+xml
+        application/xml
+        text/xml
+        text/plain
+        application/manifest+json;
+
     include /etc/nginx/conf.d/*.conf;
 }
