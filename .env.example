APP_ENV=local
APP_DEBUG=false
HTTP_PORT=80
HTTPS_PORT=443
# Domínios reais em produção (DNS já apontado para o IP da VPS). Deixe em branco para uso local (*.localhost).
VETOROS_DOMAIN=vetoros.com.br
VETORPET_DOMAIN=vetorpet.com.br
ABRASILSISTEMA_DOMAIN=abrasilsistemas.com.br
# E-mail usado pelo Let's Encrypt para avisos de expiração/renovação de certificado.
CERTBOT_EMAIL=change-me@example.com
# Defina para publicar com o domínio/https reais; sem isso, usa http://vetoros.localhost etc.
VETOROS_APP_URL=https://vetoros.com.br
VETORPET_APP_URL=https://vetorpet.com.br
ABRASILSISTEMA_APP_URL=https://abrasilsistemas.com.br
VETOROS_APP_KEY=base64:change-me-with-php-artisan-key-generate
VETORPET_APP_KEY=base64:change-me-with-php-artisan-key-generate
ABRASILSISTEMA_APP_KEY=base64:change-me-with-php-artisan-key-generate
MYSQL_ROOT_PASSWORD=change-me-root
VETOROS_DB_PASSWORD=change-me-vetoros
VETORPET_DB_PASSWORD=change-me-vetorpet
ABRASILSISTEMA_DB_PASSWORD=change-me-abrasilsistema
WAHA_PORT=3000
WAHA_ENGINE=NOWEB
WAHA_API_KEY=change-me-waha-key
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-waha-dashboard-password
# Porta publicada no host para o phpMyAdmin (login com usuário/senha do MySQL)
PHPMYADMIN_PORT=8084
# n8n (automação de prospecção do CRM ABrasil Sistemas). Usa SQLite interno (sem Postgres) e não fica publicado na porta host; acesso só via Nginx/HTTPS.
N8N_DOMAIN=n8n.abrasilsistemas.com.br
N8N_APP_URL=https://n8n.abrasilsistemas.com.br
N8N_PROTOCOL=https
# Gere com: openssl rand -hex 32 — chave usada pelo n8n para criptografar credenciais salvas; nunca trocar depois de criada sem re-inserir as credenciais.
N8N_ENCRYPTION_KEY=change-me-with-openssl-rand-hex-32
